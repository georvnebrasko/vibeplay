{
  "name": "vibeplay",
  "private": true,
  "version": "1.0.0",
  "main": "electron.cjs",
  "type": "module",

  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "electron": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist": "electron-builder"
  },

  "dependencies": {
    "axios": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },

  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },

  "build": {
    "appId": "com.vibeplay.app",
    "productName": "VibePlay",

    "directories": {
      "output": "dist"
    },

    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json"
    ],

    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "icon": "src/assets/icon.png"
    }
  }
}